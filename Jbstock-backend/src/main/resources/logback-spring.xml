<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- The file appender is attached after LocalStorage has resolved the persistent root. -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="com.jbstock.backend.diagnostics.SafeLogEncoder"/>
    </appender>
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
